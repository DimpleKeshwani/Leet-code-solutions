class Solution {
    public boolean checkIfPangram(String sentence) {

         int [] res=new int[26];
         if (sentence.length() < 26) {
            return false;
        }
         int n=sentence.length();
         for(int i=0;i<n;i++){
            //char ch=sentence[i];
             res[sentence.charAt(i) - 'a']++;
         }
         for(int count:res){
            if(count==0) return false;
         }
         return true;
    }
}
